#!/usr/bin/env bash
# Единственная точка входа для привилегированных операций бота.
#
# Бот вызывает только подкоманды этого скрипта и никогда не передаёт
# произвольные строки в shell: sudo-правило в install/stacksentry-sudoers
# разрешает ровно этот список. Аргументы здесь тоже проверяются — даже при
# ошибке в коде бота выполнить что-то незапланированное не получится.
#
# Установка:
#   sudo install -o root -g root -m 0755 stacksentry-ctl /usr/local/bin/stacksentry-ctl
set -euo pipefail

#: Каталог установки. Установщик пишет его в /etc/stacksentry.conf, чтобы
#: self-update работал и при нестандартном --prefix.
PREFIX_CONF="${PREFIX_CONF:-/etc/stacksentry.conf}"
# Не доверяем PATH окружения: root-обёртка ищет «фиксированные» бинарники.
# STACKSENTRY_CTL_PATH — только для тестового стенда, в бою не задаётся.
if [ -n "${STACKSENTRY_CTL_PATH:-}" ]; then
    export PATH="$STACKSENTRY_CTL_PATH"
else
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
fi

log() {
    logger -t stacksentry-ctl -- "$*" 2>/dev/null || true
}

die() {
    echo "stacksentry-ctl: $*" >&2
    exit 2
}

# expected — сколько аргументов ожидается ПОСЛЕ подкоманды.
# Вызывается как require_no_extra_args N "$@", поэтому в "$@" лежит весь
# список аргументов скрипта, начиная с самой подкоманды: её не считаем.
require_no_extra_args() {
    local expected="$1"
    shift
    [ "$(( $# - 1 ))" -eq "$expected" ] || die "неверное число аргументов"
}

safe_unit() {
    local unit="$1"
    # Только имя systemd-юнита: буквы, цифры, дефис, точка, подчёркивание.
    [[ "$unit" =~ ^[a-zA-Z0-9][a-zA-Z0-9._@-]*$ ]] || die "недопустимое имя сервиса: $unit"
    printf '%s' "$unit"
}

safe_int() {
    local value="$1"
    [[ "$value" =~ ^[0-9]{1,6}$ ]] || die "ожидалось число: $value"
    printf '%s' "$value"
}

update_pin() {
    # Пин обновления хранится в root-owned конфиге и задаётся оператором.
    # Пин опционален: без него self-update идёт из UPDATE_REF (по умолчанию main).
    [ -r "$PREFIX_CONF" ] || return 1
    (
        # shellcheck disable=SC1090
        . "$PREFIX_CONF"
        printf '%s\n%s\n' "${UPDATE_SHA256:-}" "${UPDATE_REF:-main}"
    )
}

install_prefix() {
    local prefix="${STACKSENTRY_PREFIX:-}"
    if [ -z "$prefix" ] && [ -r "$PREFIX_CONF" ]; then
        # Файл должен принадлежать root и быть недоступен на запись другим:
        # иначе подмена PREFIX увела бы self-update в чужой каталог.
        [ "$(stat -c '%u' "$PREFIX_CONF" 2>/dev/null || echo '')" = "0" ] \
            || die "$PREFIX_CONF должен принадлежать root"
        _mode="$(stat -c '%a' "$PREFIX_CONF" 2>/dev/null || echo '')"
        case "$_mode" in
            *[2367]) die "$PREFIX_CONF доступен на запись группе/другим" ;;
        esac
        # shellcheck disable=SC1090
        . "$PREFIX_CONF"
        prefix="${PREFIX:-}"
    fi
    [ -n "$prefix" ] || prefix="/opt/stacksentry"
    case "$prefix" in
        /*) ;;
        *) die "PREFIX в $PREFIX_CONF должен быть абсолютным путём" ;;
    esac
    printf '%s' "$prefix"
}

#: Пакетный менеджер определяется по факту наличия. PKG_BACKEND позволяет
#: зафиксировать его для тестов, как SVC_BACKEND для менеджера служб.
PKG_KIND=""
pkg_backend() {
    if [ -n "${PKG_BACKEND:-}" ]; then
        case "$PKG_BACKEND" in
            apt|dnf|yum|zypper|pacman|apk|xbps|emerge|eopkg|pkg)
                PKG_KIND="$PKG_BACKEND"; return 0 ;;
            *) die "PKG_BACKEND=$PKG_BACKEND не поддерживается" ;;
        esac
    fi
    if command -v apt-get >/dev/null 2>&1; then PKG_KIND=apt
    elif command -v dnf >/dev/null 2>&1; then PKG_KIND=dnf
    elif command -v yum >/dev/null 2>&1; then PKG_KIND=yum
    elif command -v zypper >/dev/null 2>&1; then PKG_KIND=zypper
    elif command -v pacman >/dev/null 2>&1; then PKG_KIND=pacman
    elif command -v apk >/dev/null 2>&1; then PKG_KIND=apk
    elif command -v xbps-install >/dev/null 2>&1; then PKG_KIND=xbps
    elif command -v emerge >/dev/null 2>&1; then PKG_KIND=emerge
    elif command -v eopkg >/dev/null 2>&1; then PKG_KIND=eopkg
    elif command -v pkg >/dev/null 2>&1; then PKG_KIND=pkg
    else
        die "не найден поддерживаемый пакетный менеджер"
    fi
}

priv_state_dir() {
    # Root-воркеры пишут сюда, а не в STATE_DIR сервисного пользователя:
    # иначе подложенный symlink (apt-upgrade.status -> /etc/sudoers) заставил бы
    # root писать в чужой файл. Каталог root-owned 0700, сервис его не меняет.
    local dir="${STATE_DIR:-/var/lib/stacksentry}/root"
    mkdir -p "$dir" 2>/dev/null || die "не удалось создать $dir"
    chown root:root "$dir" 2>/dev/null || true
    chmod 0700 "$dir" 2>/dev/null || true
    printf '%s' "$dir"
}

safe_write() {
    # Атомарная запись: mktemp в root-owned каталоге + mv. mv заменяет
    # symlink, а не идёт по нему, поэтому TOCTOU/symlink-атака не срабатывает.
    local target="$1" dir tmp
    dir="$(dirname "$target")"
    tmp="$(mktemp "$dir/.tmp.XXXXXX")" || return 1
    cat >"$tmp" || { rm -f "$tmp"; return 1; }
    chmod 0600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$target"
}

apt_enqueue() {
    # $1 — имя transient-юнита, $2 — внутренняя подкоманда воркера,
    # $3 — описание для systemd, $4 — имя лог-файла для фонового режима.
    # Сначала пробуем transient-юнит (чисто, systemd ведёт журнал). Если
    # systemd-run недоступен — например, sudo-rs/polkit требует интерактивную
    # аутентификацию — падаем в фоновый запуск отдельной сессией. Иначе кнопка
    # «Обновить систему» молча не работала.
    local unit="$1" worker="$2" description="$3" log_name="$4" kind="$5"
    local apt_dir
    apt_dir="$(priv_state_dir)"
    rm -f "$apt_dir/apt-${kind}.status" "$apt_dir/apt-${kind}.packages" \
        2>/dev/null || true
    # 1) Постоянный юнит (ставится установщиком). Это надёжнее transient-юнита:
    #    systemd-run в daemon-контексте проходит polkit и без терминала падает.
    local service="${unit}.service"
    local unit_dir="${SYSTEMD_UNIT_DIR:-/etc/systemd/system}"
    if command -v systemctl >/dev/null 2>&1 \
        && [ -f "${unit_dir}/${service}" ]; then
        if systemctl start --no-block "$service" 2>/dev/null; then
            echo "Задача запущена (юнит $service)."
            return 0
        fi
        log "systemctl start $service не сработал — пробую systemd-run"
    fi
    # 2) Transient-юнит.
    if command -v systemd-run >/dev/null 2>&1; then
        local srun_err="/tmp/stacksentry-ctl-systemd-run.$$"
        if systemd-run --quiet --unit="$unit" --collect \
            --description="$description" \
            --property=Type=exec \
            --property=TimeoutStartSec=3600 \
            "$0" "$worker" 2>"$srun_err"; then
            rm -f "$srun_err"
            echo "Задача запущена (юнит $unit)."
            return 0
        fi
        log "systemd-run не сработал ($(tr -d '\n' <"$srun_err" 2>/dev/null)) — фон"
        rm -f "$srun_err"
    fi
    if [ "$kind" = "selfupdate" ]; then
        # Фоновый запуск от сервисного пользователя не получит root и молча
        # провалит обновление. Лучше вернуть ошибку в бот, чем врать «запущено».
        die "не удалось запустить self-update: установите stacksentry-self-update.service"
    fi
    local apt_log="$apt_dir/$log_name"
    env -u SUDO_USER setsid nohup "$0" "$worker" >>"$apt_log" 2>&1 &
    echo "Задача запущена в фоне."
    return 0
}

apt_status_write() {
    # $1 — вид обновления, $2 — код возврата. Нужен для систем без systemd,
    # где нельзя спросить состояние юнита у systemctl.
    local dir
    dir="$(priv_state_dir)"
    printf 'EXIT=%s\n' "$2" | safe_write "$dir/apt-$1.status" 2>/dev/null || true
}

#: Менеджер служб выбирается по факту наличия: одна и та же обёртка работает в
#: systemd-, OpenRC- (Alpine/Gentoo) и SysV-системах.
#: Результат определённия менеджера служб (заполняет svc_backend).
SVC_KIND=""

svc_backend() {
    # SVC_BACKEND позволяет зафиксировать менеджер служб вручную: нужен для
    # тестов и для систем, где автодетект ошибается.
    if [ -n "${SVC_BACKEND:-}" ]; then
        case "$SVC_BACKEND" in
            systemd | openrc | sysv) SVC_KIND="$SVC_BACKEND"; return 0 ;;
            *) die "SVC_BACKEND=$SVC_BACKEND не поддерживается" ;;
        esac
    fi
    if command -v systemctl >/dev/null 2>&1; then
        SVC_KIND=systemd
    elif command -v rc-service >/dev/null 2>&1; then
        SVC_KIND=openrc
    elif command -v service >/dev/null 2>&1; then
        SVC_KIND=sysv
    else
        die "не найден менеджер служб (systemctl, rc-service или service)"
    fi
}

svc_restart() {
    svc_backend
    case "$SVC_KIND" in
        systemd) systemctl restart "$1" ;;
        openrc)  rc-service "$1" restart ;;
        sysv)    service "$1" restart ;;
    esac
}

svc_active() {
    svc_backend
    case "$SVC_KIND" in
        systemd) systemctl is-active --quiet "$1" ;;
        openrc)  rc-service "$1" status >/dev/null 2>&1 ;;
        sysv)    service "$1" status >/dev/null 2>&1 ;;
    esac
}

#: Логи: journalctl, если он есть, иначе — файл лога бота (его пишет сам бот).
#: Нужно для систем без systemd, где журнала нет вовсе.
svc_log() {
    local unit="$1" lines="$2" errors="${3:-0}"
    if command -v journalctl >/dev/null 2>&1; then
        if [ "$errors" = "1" ]; then
            journalctl -u "$unit" -n "$lines" --no-pager -o short-iso -p err
        else
            journalctl -u "$unit" -n "$lines" --no-pager -o short-iso
        fi
        return 0
    fi
    local file="${LOG_PATH:-/var/lib/stacksentry/bot.log}"
    [ -f "$file" ] || die "нет journalctl и файла лога $file"
    if [ "$errors" = "1" ]; then
        grep -iE "error|critical|failed|traceback" "$file" | tail -n "$lines" || true
    else
        tail -n "$lines" "$file"
    fi
}

cmd="${1:-}"
[ -n "$cmd" ] || die "не указана подкоманда"

case "$cmd" in
    restart_service)
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        log "restart $unit"
        if ! svc_restart "$unit"; then
            echo "Не удалось перезапустить $unit. Последние строки журнала:" >&2
            svc_log "$unit" 10 >&2 || true
            exit 1
        fi
        if ! svc_active "$unit"; then
            echo "Служба $unit запущена, но не активна — проверьте: $0 journal $unit 20" >&2
            exit 1
        fi
        echo "Сервис $unit перезапущен"
        ;;

    is_active)
        # Безопасная проверка для самопроверки установки: ничего не меняет.
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        if svc_active "$unit"; then
            echo "active"
        else
            echo "inactive"
            exit 1
        fi
        ;;

    journal_errors)
        # Только ошибки: разбирать инцидент ночью удобнее по -p err.
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        svc_log "$unit" 100 1 || die "не удалось прочитать журнал $unit"
        ;;

    journal_more)
        # Журнал с запасом строк. Отдельная подкоманда, а не аргумент-число:
        # sudo-rs (Ubuntu 26.04+) запрещает шаблоны в аргументах, поэтому в
        # sudoers перечисляются точные команды.
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        svc_log "$unit" 200 0 || die "не удалось прочитать журнал $unit"
        ;;

    journal)
        require_no_extra_args 1 "$@"
        unit="$(safe_unit "$2")"
        svc_log "$unit" 40 0 || die "не удалось прочитать журнал $unit"
        ;;

    apt_upgrade)
        # Сервис бота работает с ProtectSystem=strict: его дочерние процессы
        # не могут писать в /var/lib/dpkg, /usr и /boot. Поэтому apt запускается
        # отдельным transient-юнитом — systemd создаёт для него своё окружение,
        # а бот лишь ставит задачу в очередь и сразу получает управление.
        require_no_extra_args 0 "$@"
        unit="stacksentry-apt-upgrade"
        log "apt full-upgrade requested"

        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление уже выполняется. Журнал: sudo stacksentry-menu apt-logs"
            exit 3
        fi

        apt_enqueue "$unit" _apt_worker \
            "apt full-upgrade по команде бота" "apt-upgrade.log" upgrade
        ;;

    _apt_worker)
        # Внутренняя подкоманда для юнита. Через sudo она недостижима
        # (в sudoers её нет), а проверка SUDO_USER закрывает путь даже при
        # попытке вызвать напрямую из-под сервисного пользователя.
        [ "$(id -u)" -eq 0 ] || die "_apt_worker требует root"
        [ -z "${SUDO_USER:-}" ] || die "_apt_worker недоступен через sudo"
        require_no_extra_args 0 "$@"
        pkg_backend
        export DEBIAN_FRONTEND=noninteractive
        rc=0
        case "$PKG_KIND" in
            apt)
                apt-get update || rc=$?
                if [ "$rc" -eq 0 ]; then
                    apt-get -y -o Dpkg::Options::=--force-confdef \
                        -o Dpkg::Options::=--force-confold full-upgrade || rc=$?
                fi
                if [ "$rc" -eq 0 ]; then apt-get -y autoremove || rc=$?; fi
                if [ "$rc" -eq 0 ]; then apt-get clean || rc=$?; fi
                ;;
            dnf)   dnf -y upgrade || rc=$? ;;
            yum)   yum -y update || rc=$? ;;
            zypper) zypper --non-interactive update || rc=$? ;;
            pacman) pacman -Syu --noconfirm || rc=$? ;;
            apk)   apk upgrade || rc=$? ;;
            xbps)  xbps-install -Su || rc=$? ;;
            emerge) emerge -uDN @world || rc=$? ;;
            eopkg) eopkg upgrade -y || rc=$? ;;
            pkg)   pkg upgrade -y || rc=$? ;;
        esac
        apt_status_write upgrade "$rc"
        echo "$PKG_KIND: обновление завершено (код $rc)"
        exit "$rc"
        ;;

    apt_upgrade_phased)
        # Обычный upgrade, но с явно включёнными phased-обновлениями. Ubuntu
        # придерживает часть пакетов (phased rollout), из-за чего «обновлений
        # нет», хотя они есть. Отдельная подкоманда, а не флаг: бот не должен
        # уметь собирать произвольные команды apt.
        require_no_extra_args 0 "$@"
        unit="stacksentry-apt-phased"
        log "apt upgrade (phased) requested"

        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление уже выполняется. Журнал: sudo stacksentry-menu apt-logs"
            exit 3
        fi

        apt_enqueue "$unit" _apt_worker_phased \
            "apt upgrade с phased-обновлениями по команде бота" "apt-phased.log" phased
        ;;

    apt_update)
        # Только обновление индексов пакетов: быстро и безопасно.
        require_no_extra_args 0 "$@"
        unit="stacksentry-apt-update"
        log "apt update requested"
        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление индексов уже выполняется."
            exit 3
        fi
        apt_enqueue "$unit" _apt_update_worker \
            "apt update по команде бота" "apt-update.log" update
        ;;

    _apt_update_worker)
        [ "$(id -u)" -eq 0 ] || die "_apt_update_worker требует root"
        [ -z "${SUDO_USER:-}" ] || die "_apt_update_worker недоступен через sudo"
        require_no_extra_args 0 "$@"
        pkg_backend
        export DEBIAN_FRONTEND=noninteractive
        rm -f "$(priv_state_dir)/apt-update.packages" \
            2>/dev/null || true
        rc=0
        case "$PKG_KIND" in
            apt)    apt-get update || rc=$? ;;
            dnf)    dnf -y makecache || rc=$? ;;
            yum)    yum -y makecache || rc=$? ;;
            zypper) zypper --non-interactive refresh || rc=$? ;;
            pacman) pacman -Sy --noconfirm || rc=$? ;;
            apk)    apk update || rc=$? ;;
            xbps)   xbps-install -S || rc=$? ;;
            emerge) emerge --sync || rc=$? ;;
            eopkg)  eopkg update-repo -y || rc=$? ;;
            pkg)    pkg update -y || rc=$? ;;
        esac
        if [ "$rc" -eq 0 ] && [ "$PKG_KIND" = "apt" ]; then
            # Показываем не только «индексы обновлены», но и что именно
            # доступно к обновлению. Список дублируем в файл: журнал systemd
            # длинный, и бот раньше обрезал строку с пакетами.
            _pkgs="$(apt list --upgradable 2>/dev/null | sed -n '2,$p' \
                | cut -d/ -f1 | sed '/^$/d')"
            _count="$(printf '%s\n' "$_pkgs" | sed '/^$/d' | wc -l | tr -d ' ')"
            _pkg_file="$(priv_state_dir)/apt-update.packages"
            printf '%s\n%s\n' "${_count:-0}" \
                "$(printf '%s' "$_pkgs" | tr '\n' ' ' | sed 's/ *$//')" \
                | safe_write "$_pkg_file" 2>/dev/null || true
            if [ "${_count:-0}" -eq 0 ]; then
                echo "Обновлений нет."
            else
                echo "К обновлению ($_count): $(printf '%s' "$_pkgs" | tr '\n' ' ')"
            fi
        elif [ "$rc" -eq 0 ]; then
            echo "Индексы пакетов обновлены ($PKG_KIND)."
        fi
        apt_status_write update "$rc"
        echo "$PKG_KIND: обновление индексов завершено (код $rc)"
        exit "$rc"
        ;;

    _apt_worker_phased)
        # Внутренняя подкоманда для юнита (см. _apt_worker).
        [ "$(id -u)" -eq 0 ] || die "_apt_worker_phased требует root"
        [ -z "${SUDO_USER:-}" ] || die "_apt_worker_phased недоступен через sudo"
        require_no_extra_args 0 "$@"
        pkg_backend
        [ "$PKG_KIND" = "apt" ] || { echo "phased-обновления поддерживаются только APT."; exit 0; }
        export DEBIAN_FRONTEND=noninteractive
        rc=0
        apt-get update || rc=$?
        if [ "$rc" -eq 0 ]; then
            apt-get -y -o APT::Get::Always-Include-Phased-Updates=true upgrade \
                || rc=$?
        fi
        if [ "$rc" -eq 0 ]; then
            apt-get -y autoremove || rc=$?
        fi
        if [ "$rc" -eq 0 ]; then
            apt-get clean || rc=$?
        fi
        apt_status_write phased "$rc"
        echo "upgrade (phased) завершён (код $rc)"
        exit "$rc"
        ;;

    dist_upgrade)
        require_no_extra_args 0 "$@"
        pkg_backend
        if [ "$PKG_KIND" != "apt" ]; then
            echo "Проверка релиз-обновления реализована только для APT (Debian/Ubuntu)."
            exit 0
        fi
        export DEBIAN_FRONTEND=noninteractive
        if ! command -v do-release-upgrade >/dev/null 2>&1; then
            echo "do-release-upgrade не установлен (это не Ubuntu либо пакет update-manager отсутствует)"
            exit 0
        fi
        # У сервиса HOME=PREFIX, а он read-only (ProtectSystem=strict): python
        # внутри do-release-upgrade падал на mkdir() .cache. Даём записываемый
        # HOME/XDG_CACHE_HOME в каталоге состояния.
        _dr_home="$(priv_state_dir)/release-upgrade"
        mkdir -p "$_dr_home/cache" 2>/dev/null || true
        export HOME="$_dr_home"
        export XDG_CACHE_HOME="$_dr_home/cache"
        # Шаг «Start upgrade» спрашивает подтверждение и правит конфиги в
        # интерактивном режиме. У бота нет терминала, поэтому мы только
        # проверяем доступность обновления и объясняем, что делать дальше.
        if do-release-upgrade --check-dist-upgrade-only; then
            echo "Доступно релиз-обновление (например, 22.04 -> 24.04)."
            echo "Автоматически выполнить его нельзя: do-release-upgrade требует терминала."
            echo "Выполните вручную по SSH:"
            echo "    sudo service unattended-upgrades stop"
            echo "    sudo do-release-upgrade"
            echo "После этого нажмите в боте «Перезагрузить сервер»."
            exit 0
        fi
        echo "Релиз-обновлений нет"
        ;;

    release_upgrade)
        # Отдельное действие: запуск самого do-release-upgrade, а не проверки.
        require_no_extra_args 0 "$@"
        pkg_backend
        if [ "$PKG_KIND" != "apt" ]; then
            echo "Релиз-обновление реализовано только для APT (Debian/Ubuntu)."
            exit 0
        fi
        unit="stacksentry-release-upgrade"
        log "do-release-upgrade requested"
        if ! command -v do-release-upgrade >/dev/null 2>&1; then
            echo "do-release-upgrade не установлен (это не Ubuntu либо нет update-manager)"
            exit 0
        fi
        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Релиз-обновление уже выполняется."
            exit 3
        fi
        apt_enqueue "$unit" _release_upgrade_worker \
            "do-release-upgrade по команде бота" "release-upgrade.log" release
        ;;

    _release_upgrade_worker)
        [ "$(id -u)" -eq 0 ] || die "_release_upgrade_worker требует root"
        [ -z "${SUDO_USER:-}" ] || die "_release_upgrade_worker недоступен через sudo"
        require_no_extra_args 0 "$@"
        export DEBIAN_FRONTEND=noninteractive
        _dr_home="$(priv_state_dir)/release-upgrade"
        mkdir -p "$_dr_home/cache" 2>/dev/null || true
        export HOME="$_dr_home"
        export XDG_CACHE_HOME="$_dr_home/cache"
        # unattended-upgrades может держать блокировку apt.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl stop unattended-upgrades >/dev/null 2>&1 || true
        fi
        rc=0
        _dr_out="$(do-release-upgrade -f DistUpgradeViewNonInteractive 2>&1)" || rc=$?
        printf '%s\n' "$_dr_out"
        # Штатный «нет нового релиза» — это код 1, но не ошибка.
        if [ "$rc" -ne 0 ] \
            && printf '%s' "$_dr_out" | grep -qiE 'no new release found'; then
            rc=0
            echo "Релиз-обновлений нет — это не ошибка."
        fi
        apt_status_write release "$rc"
        echo "do-release-upgrade завершён (код $rc)"
        exit "$rc"
        ;;

    update_bot)
        # Обновление самого бота из main. Установщик запускается отдельным
        # юнитом: сервис с ProtectSystem=strict не может писать в $PREFIX.
        require_no_extra_args 0 "$@"
        unit="stacksentry-self-update"
        prefix="$(install_prefix)"
        installer="$prefix/install.sh"
        [ -f "$installer" ] || die "не найден $installer — переустановите бота"
        [ "$(stat -c '%u' "$installer" 2>/dev/null || echo '')" = "0" ] \
            || die "$installer должен принадлежать root"
        mode="$(stat -c '%a' "$installer" 2>/dev/null || echo '')"
        case "$mode" in
            *[2367]) die "$installer доступен на запись группе/другим" ;;
        esac
        { read -r _pin_sha; read -r _pin_ref; } < <(update_pin) || true
        [ -n "${_pin_ref:-}" ] || _pin_ref="main"
        if [ -n "${_pin_sha:-}" ]; then
            log "self-update requested ($prefix, ref=$_pin_ref, sha=${_pin_sha:0:12}…)"
        else
            log "self-update requested ($prefix, ref=$_pin_ref, unpinned)"
        fi
        if command -v systemctl >/dev/null 2>&1 \
            && systemctl is-active --quiet "$unit" 2>/dev/null; then
            echo "Обновление уже выполняется."
            exit 3
        fi
        apt_enqueue "$unit" _self_update_worker \
            "StackSentry self-update" "self-update.log" selfupdate
        ;;

    _self_update_worker)
        # Внутренняя подкоманда для юнита; через sudo в sudoers её нет.
        [ "$(id -u)" -eq 0 ] || die "_self_update_worker требует root"
        [ -z "${SUDO_USER:-}" ] || die "_self_update_worker недоступен через sudo"
        require_no_extra_args 0 "$@"
        prefix="$(install_prefix)"
        installer="$prefix/install.sh"
        [ -f "$installer" ] || die "не найден $installer"
        # Копируем установщик в пустой каталог: иначе он найдёт локальные
        # исходники рядом с собой и «обновит» старую копию вместо main.
        { read -r _pin_sha; read -r _pin_ref; } < <(update_pin) || true
        [ -n "${_pin_ref:-}" ] || _pin_ref="main"
        tmp="$(mktemp -d)"
        cp -a "$installer" "$tmp/install.sh"
        cd "$tmp"
        _args=(--yes --update --prefix "$prefix" --ref "$_pin_ref")
        [ -n "${_pin_sha:-}" ] && _args+=(--sha256 "$_pin_sha")
        rc=0
        bash "$tmp/install.sh" "${_args[@]}" || rc=$?
        rm -rf "$tmp"
        exit "$rc"
        ;;

    apt_status)
        # Состояние фонового юнита + хвост журнала. Только фиксированные виды:
        # произвольное имя юнита сюда передать нельзя.
        require_no_extra_args 1 "$@"
        case "$2" in
            update)  unit="stacksentry-apt-update" ;;
            upgrade) unit="stacksentry-apt-upgrade" ;;
            phased)  unit="stacksentry-apt-phased" ;;
            release) unit="stacksentry-release-upgrade" ;;
            *) die "неизвестный вид обновления: $2" ;;
        esac
        state="unknown"; result="unknown"; code="unknown"; load="unknown"
        if command -v systemctl >/dev/null 2>&1; then
            state="$(systemctl is-active "$unit" 2>/dev/null || true)"
            result="$(systemctl show -p Result --value "$unit" 2>/dev/null || true)"
            code="$(systemctl show -p ExecMainStatus --value "$unit" 2>/dev/null || true)"
            load="$(systemctl show -p LoadState --value "$unit" 2>/dev/null || true)"
        fi
        # Фолбэк без systemd: воркер пишет файл со своим кодом возврата.
        _status_file="$(priv_state_dir)/apt-$2.status"
        if [ -f "$_status_file" ]; then
            _rc="$(sed -n 's/^EXIT=//p' "$_status_file" | head -1)"
            if [ -n "$_rc" ]; then
                state="inactive"; code="$_rc"
                if [ "$_rc" = "0" ]; then result="success"; else result="failed"; fi
            fi
        fi
        _pkg_file="$(priv_state_dir)/apt-$2.packages"
        _pkg_count=""
        _pkg_list=""
        if [ -f "$_pkg_file" ]; then
            _pkg_count="$(sed -n '1p' "$_pkg_file" 2>/dev/null || true)"
            _pkg_list="$(sed -n '2p' "$_pkg_file" 2>/dev/null || true)"
        fi
        printf 'STATE=%s\nRESULT=%s\nEXIT=%s\nLOAD=%s\nPACKAGES=%s\nPACKAGE_LIST=%s\n' \
            "${state:-unknown}" "${result:-unknown}" "${code:-unknown}" \
            "${load:-unknown}" "${_pkg_count:-}" "${_pkg_list:-}"
        if command -v journalctl >/dev/null 2>&1; then
            journalctl -u "$unit" -n 40 --no-pager -o cat 2>/dev/null || true
        elif [ -f "$(priv_state_dir)/apt-$2.log" ]; then
            tail -n 40 "$(priv_state_dir)/apt-$2.log" 2>/dev/null || true
        fi
        ;;

    reboot)
        require_no_extra_args 0 "$@"
        log "reboot requested by monitor bot"
        sync
        # systemd выключит бота и панель штатно, без обрыва файловой системы.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl reboot
        elif command -v shutdown >/dev/null 2>&1; then
            shutdown -r now
        else
            reboot
        fi
        echo "reboot отправлен"
        ;;

    run_command)
        # Ровно один аргумент: команда приходит одной строкой и сверяется со
        # списком ниже. Запускаем её как argv, без `bash -c`: shell-парсинга
        # нет вообще, поэтому даже правка allowlist не даст инъекцию.
        require_no_extra_args 1 "$@"
        command="$2"
        # Ключи (пробелы заменены на «_») — то, что перечисляет sudoers;
        # строки команд поддержаны для обратной совместимости.
        # Только чтение: ни одна ветка не пишет, не перезапускает и не удаляет.
        # Псевдонимы короче и не ломают sudoers (пробелы → «_»).
        case "$command" in
            "journalctl_--disk-usage" | "journalctl --disk-usage")
                set -- journalctl --disk-usage ;;
            "systemctl_list-timers_--all" | "systemctl list-timers --all")
                set -- systemctl list-timers --all ;;
            "df_-h" | "df -h")             set -- df -h ;;
            "free_-h" | "free -h")         set -- free -h ;;
            "uptime")                      set -- uptime ;;
            "x-ui_status" | "x-ui status") set -- x-ui status ;;
            "os_logs")        set -- journalctl -p warning -n 100 --no-pager ;;
            "os_logs_more")   set -- journalctl -p warning -n 300 --no-pager ;;
            "os_logs_errors") set -- journalctl -p err -n 200 --no-pager ;;
            "os_errors")      set -- journalctl -p err -n 100 --no-pager ;;
            "kernel_logs")    set -- journalctl -k -n 100 --no-pager ;;
            "kernel_logs_more") set -- journalctl -k -n 300 --no-pager ;;
            "kernel_logs_errors") set -- journalctl -k -p err -n 200 --no-pager ;;
            "xui_logs")       set -- journalctl -u x-ui -n 100 --no-pager ;;
            "xui_logs_more")  set -- journalctl -u x-ui -n 300 --no-pager ;;
            "xui_logs_errors") set -- journalctl -u x-ui -p err -n 200 --no-pager ;;
            "dmesg")          set -- dmesg --ctime ;;
            "dmesg_errors")   set -- dmesg --ctime --level=err ;;
            "sockets")        set -- ss -tulpn ;;
            "net_summary")    set -- ss -s ;;
            "addresses")      set -- ip -br a ;;
            "routes")         set -- ip route ;;
            "failed_units")   set -- systemctl --failed --no-pager ;;
            "xui_service")    set -- systemctl status x-ui --no-pager -l ;;
            "uname")          set -- uname -a ;;
            "top_cpu")        set -- ps -eo pid,comm,pcpu,pmem --sort=-pcpu ;;
            "log_size")       set -- du -sh /var/log ;;
            "inodes")         set -- df -i ;;
            "upgradable")     set -- apt list --upgradable ;;
            "upgrade_sim")    set -- apt-get -s upgrade ;;
            "vmstat")         set -- vmstat 1 3 ;;
            "time_status")    set -- timedatectl ;;
            "logged_in")      set -- w ;;
            "boot_time")      set -- who -b ;;
            "cpu_info")       set -- lscpu ;;
            "block_devices")  set -- lsblk ;;
            *) die "команда не разрешена: $command" ;;
        esac
        command -v "$1" >/dev/null 2>&1 \
            || die "команда «$1» не установлена на этом сервере"
        log "run allowed: $command"
        exec "$@"
        ;;

    *)
        die "неизвестная подкоманда: $cmd"
        ;;
esac
