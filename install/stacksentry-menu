#!/usr/bin/env bash
#
# stacksentry-menu — консольная панель StackSentry.
#
# Запуск:  sudo stacksentry-menu            # интерактивное меню
#          sudo stacksentry-menu status     # состояние службы
#          sudo stacksentry-menu show       # настройки (секреты замаскированы)
#          sudo stacksentry-menu keys       # какие ключи можно менять
#          sudo stacksentry-menu set PANEL_TIMEOUT 20
#          stacksentry-menu check PANEL_TIMEOUT 20   # проверка без изменений (без root)
#          sudo stacksentry-menu restart | logs [N] | update | uninstall [--purge]
#
# Меню меняет только ключи из белого списка, пишет .env атомарно с правами
# 640 root:<сервисный пользователь> и перезапускает службу по подтверждению.
set -euo pipefail

PREFIX="${PREFIX:-/opt/stacksentry}"
ENV_FILE="${ENV_FILE:-$PREFIX/.env}"
SERVICE_NAME="${SERVICE_NAME:-stacksentry-bot}"
SERVICE_USER="${SERVICE_USER:-stacksentry}"
REPO_URL="${REPO_URL:-https://github.com/Hijackery/stacksentry}"
REPO_REF="${REPO_REF:-main}"

# Ответы читаем с терминала: меню может быть запущено и через пайп.
READ_FD=0
if [ ! -t 0 ] && { exec 3</dev/tty; } 2>/dev/null; then
    READ_FD=3
fi

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
YELLOW=$'\033[33m'; BLUE=$'\033[34m'; RESET=$'\033[0m'
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then
    BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; RESET=""
fi

# --- оформление меню ------------------------------------------------------
# Рамка рисуется по самой длинной строке, чтобы ничего не разъезжалось. Ширину
# считаем по видимому тексту (ANSI-последовательности выкидываем).
strip_ansi() { printf '%s' "$1" | sed -E $'s/\x1b\\[[0-9;]*m//g'; }
vis_len() { local t; t="$(strip_ansi "$1")"; printf '%s' "${#t}"; }
repeat_char() {
    local out=""
    printf -v out '%*s' "$1" ''
    printf '%s' "${out// /$2}"
}

# Пункты меню: g|заголовок группы, s|разделитель, ЧИСЛО|подпись.
MENU_ROWS=(
    "g|Диагностика"
    "1|Состояние службы и последние ошибки"
    "2|Показать настройки (секреты замаскированы)"
    "3|Журнал бота (последние 50 строк)"
    "4|Что найдено на сервере (ОС, панели, VPN)"
    "s|"
    "g|Telegram"
    "5|Токен бота (@BotFather)"
    "6|ID администраторов"
    "7|Чат для алертов"
    "s|"
    "g|Панель"
    "8|Тип панели (3x-ui/marzban/marzneshin/pasarguard/remnawave/s-ui/hiddify/outline)"
    "9|Адрес панели (PANEL_URL)"
    "10|Путь панели / webBasePath"
    "11|API-токен панели"
    "12|Логин и пароль (Marzban)"
    "13|Проверка TLS и CA-сертификат"
    "s|"
    "g|Пороги и алерты"
    "14|Загрузка CPU (предупреждение/критично)"
    "15|Память (предупреждение/критично)"
    "16|Диск (предупреждение/критично)"
    "17|Гистерезис и кулдаун"
    "18|За сколько дней предупреждать о подписке"
    "s|"
    "g|Обслуживание"
    "19|Службы под наблюдением"
    "20|Уровень логирования"
    "21|Изменить любой ключ по имени"
    "22|Перезапустить бота"
    "23|Перезапустить ядро панели (3X-UI/Marzban/PasarGuard/S-UI)"
    "24|Обновить бота с GitHub"
    "s|"
    "g|Безопасность и доступ"
    "25|Проверить обновления StackSentry"
    "26|Показать TOTP-секрет / настроить 2FA"
    "27|Статус Mini App и адрес для /setdomain"
    "s|"
    "28|Удалить бота"
    "29|Язык интерфейса бота и Mini App (ru/en)"
    "0|Выход"
)

menu_max() {
    local spec n max=0
    for spec in "${MENU_ROWS[@]}"; do
        case "$spec" in
            g\|*|s\|*) continue ;;
        esac
        n="${spec%%|*}"
        (( n > max )) && max=$n
    done
    printf '%s' "$max"
}

draw_menu() {
    local status="$1" title="StackSentry — панель управления"
    local -a rows=("$title" "$status") kinds=("title" "status")
    local spec kind payload
    for spec in "${MENU_ROWS[@]}"; do
        kind="${spec%%|*}"; payload="${spec#*|}"
        case "$kind" in
            g) rows+=("  $payload"); kinds+=("group") ;;
            s) rows+=(""); kinds+=("sep") ;;
            *) rows+=("$(printf '  %2s. %s' "$kind" "$payload")"); kinds+=("item") ;;
        esac
    done

    local w=0 r lw
    for r in "${rows[@]}"; do lw="$(vis_len "$r")"; (( lw > w )) && w=$lw; done
    (( w < 54 )) && w=54
    local inner=$(( w + 2 ))

    printf '\n%s%s%s\n' "$BLUE" "╔$(repeat_char "$inner" '═')╗" "$RESET"
    local i row text pad
    for i in "${!rows[@]}"; do
        row="${rows[$i]}"; kind="${kinds[$i]}"
        if [ "$kind" = "sep" ]; then
            printf '%s%s%s\n' "$BLUE" "│$(repeat_char "$inner" '─')│" "$RESET"
            continue
        fi
        case "$kind" in
            title)
                text="$BOLD$row$RESET"
                pad=$(( (w - $(vis_len "$row")) / 2 ))
                ;;
            group) text="$BOLD$row$RESET"; pad=0 ;;
            status) text=" $row"; pad=0 ;;
            *) text="$row"; pad=0 ;;
        esac
        local fill=$(( w - pad - $(vis_len "$row") ))
        (( fill < 0 )) && fill=0
        printf '%s│%s %s%s%s %s│%s\n' \
            "$BLUE" "$RESET" "$(repeat_char "$pad" ' ')" "$text" \
            "$(repeat_char "$fill" ' ')" "$BLUE" "$RESET"
    done
    printf '%s%s%s\n' "$BLUE" "╚$(repeat_char "$inner" '═')╝" "$RESET"
}

menu_status_line() {
    local st="неизвестно" color="$DIM"
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null; then
            st="работает"; color="$GREEN"
        else
            st="остановлена"; color="$RED"
        fi
    elif command -v rc-service >/dev/null 2>&1; then
        st="OpenRC"; color="$DIM"
    fi
    printf 'Служба %s: %s●%s %s' "$SERVICE_NAME" "$color" "$RESET" "$st"
}


ok()   { printf '      %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
info() { printf '      %s\n' "$1"; }
warn() { printf '      %s!%s %s\n' "$YELLOW" "$RESET" "$1"; }

show_totp_qr() {
    local uri="$1" kind="UTF8"
    if command -v qrencode >/dev/null 2>&1; then
        if qrencode --help 2>&1 | grep -q 'ANSIUTF8'; then
            kind="ANSIUTF8"
        fi
        printf '\n'
        qrencode -t "$kind" -m 2 -s 1 -o - "$uri" \
            || info "QR не нарисован — отсканируйте otpauth вручную."
        printf '\n'
    else
        info "QR: установите qrencode: sudo apt install qrencode"
    fi
}
die()  { printf '%s✗ %s%s\n' "$RED" "$1" "$RESET" >&2; exit 1; }
head1(){ printf '\n%s%s%s\n' "$BOLD$BLUE" "$1" "$RESET"; }

need_root() {
    [ "$(id -u)" -eq 0 ] || die "Нужен root: sudo stacksentry-menu $*"
}

need_env() {
    [ -f "$ENV_FILE" ] || die "Не найден $ENV_FILE — бот установлен?"
}

#: Ключи, которые безопасно менять из меню (значения проверяются ниже).
EDITABLE_KEYS=(
    TELEGRAM_BOT_TOKEN TELEGRAM_ADMIN_IDS ALERT_CHAT_ID TELEGRAM_API_URL
    PANEL_URL PANEL_BASE_PATH PANEL_API_TOKEN PANEL_TYPE PANEL_USERNAME PANEL_PASSWORD PANEL_VERIFY_TLS PANEL_CA_BUNDLE
    SERVICES DISK_PATH PANEL_TIMEOUT
    CPU_WARN CPU_CRIT MEM_WARN MEM_CRIT DISK_WARN DISK_CRIT
    ALERT_HYSTERESIS ALERT_COOLDOWN EXPIRING_SOON_DAYS
    CHECK_INTERVAL ACTION_COOLDOWN CONFIRM_TTL COMMAND_TIMEOUT
    COMMAND_ALLOWLIST LOG_LEVEL LANGUAGE
)

#: Разумные подсказки для пошагового изменения.
declare -A KEY_HINT=(
    [TELEGRAM_BOT_TOKEN]="токен от @BotFather (вид 123456:AA...)"
    [TELEGRAM_ADMIN_IDS]="ID администраторов через запятую"
    [ALERT_CHAT_ID]="ID чата для алертов (число, у групп отрицательное) или пусто — тогда админам в личку"
    [PANEL_URL]="адрес панели, например https://panel.example.com:2053"
    [PANEL_BASE_PATH]="webBasePath 3X-UI; у S-UI/Hiddify путь обычно уже в PANEL_URL"
    [PANEL_API_TOKEN]="токен панели (3X-UI node-sync / Remnawave / S-UI / Hiddify)"
    [PANEL_TYPE]="3x-ui, marzban, marzneshin, pasarguard, remnawave, s-ui, hiddify или outline"
    [PANEL_USERNAME]="логин администратора Marzban"
    [PANEL_PASSWORD]="пароль администратора Marzban"
    [SERVICES]="юниты под наблюдением, через запятую"
    [LOG_LEVEL]="DEBUG, INFO, WARNING или ERROR"
    [LANGUAGE]="язык интерфейса: ru или en"
)

is_editable() {
    local key="$1" known
    for known in "${EDITABLE_KEYS[@]}"; do
        [ "$known" = "$key" ] && return 0
    done
    return 1
}

# check_value KEY VALUE — проверяет значение и печатает причину отказа.
check_value() {
    local key="$1" value="$2"
    case "$key" in
        TELEGRAM_BOT_TOKEN)
            case "$value" in
                *:*) ;;
                *) die "токен @BotFather выглядит как 123456:AA... — проверьте вставку" ;;
            esac
            ;;
        TELEGRAM_ADMIN_IDS)
            printf '%s' "$value" | grep -qE '^[0-9]+(,[0-9]+)*$' \
                || die "ID должны быть числами через запятую"
            ;;
        TELEGRAM_API_URL|PANEL_URL)
            case "$value" in
                http://*|https://*) ;;
                *) die "$key должен начинаться с http:// или https://" ;;
            esac
            ;;
        CPU_WARN|CPU_CRIT|MEM_WARN|MEM_CRIT|DISK_WARN|DISK_CRIT|ALERT_HYSTERESIS|PANEL_TIMEOUT)
            printf '%s' "$value" | grep -qE '^[0-9]+([.][0-9]+)?$' \
                || die "$key — это процент, например 85"
            ;;
        ALERT_CHAT_ID)
            # У групп и каналов ID отрицательный; пусто — алерты в личку.
            [ -z "$value" ] || printf '%s' "$value" | grep -qE '^-?[0-9]+$' \
                || die "ALERT_CHAT_ID — целое число (у групп отрицательное)"
            ;;
        ALERT_COOLDOWN|EXPIRING_SOON_DAYS|CHECK_INTERVAL|ACTION_COOLDOWN|CONFIRM_TTL|COMMAND_TIMEOUT)
            printf '%s' "$value" | grep -qE '^[0-9]+$' || die "$key — целое число"
            ;;
        PANEL_TYPE)
            case "$value" in
                3x-ui|marzban|marzneshin|pasarguard|remnawave|s-ui|hiddify|outline) ;;
                *) die "PANEL_TYPE: 3x-ui, marzban, marzneshin, pasarguard, remnawave, s-ui, hiddify или outline" ;;
            esac
            ;;
        LANGUAGE)
            case "$value" in
                ru|en) ;;
                *) die "LANGUAGE: поддерживаются ru и en" ;;
            esac
            ;;
        PANEL_USERNAME)
            [ -n "$value" ] || die "PANEL_USERNAME не должен быть пустым"
            ;;
        PANEL_PASSWORD)
            case "$value" in *$'\n'*) die "пароль не должен содержать перевод строки" ;; esac
            ;;
        PANEL_VERIFY_TLS)
            case "$value" in
                true|false) ;;
                *) die "PANEL_VERIFY_TLS: true или false" ;;
            esac
            ;;
        LOG_LEVEL)
            case "$value" in
                DEBUG|INFO|WARNING|ERROR) ;;
                *) die "LOG_LEVEL: DEBUG, INFO, WARNING или ERROR" ;;
            esac
            ;;
    esac
    return 0
}

show_setting() {
    local key="$1" value
    value="$(sed -n "s/^${key}=//p" "$ENV_FILE" 2>/dev/null | head -1)"
    case "$key" in
        TELEGRAM_BOT_TOKEN|PANEL_API_TOKEN|PANEL_PASSWORD)
            # Короткое значение маскируем целиком: иначе «первые 6 + последние 4»
            # покажут почти весь секрет.
            if [ -z "$value" ]; then
                printf '  %-22s %s\n' "$key" "(пусто)"
            elif [ "${#value}" -lt 12 ]; then
                printf '  %-22s *** (%d символов)\n' "$key" "${#value}"
            else
                printf '  %-22s %s ···%s\n' "$key" "${value:0:6}" "${value: -4}"
            fi
            ;;
        *)
            printf '  %-22s %s\n' "$key" "${value:-—}"
            ;;
    esac
}

cmd_show() {
    need_env
    head1 "Настройки бота ($ENV_FILE)"
    local key
    for key in "${EDITABLE_KEYS[@]}"; do
        show_setting "$key"
    done
    info "Секреты показаны замаскированными. Изменить: sudo stacksentry-menu set KEY VALUE"
}

cmd_keys() {
    printf '%s\n' "${EDITABLE_KEYS[@]}"
}

cmd_check() {
    local key="${1:-}" value="${2:-}"
    [ -n "$key" ] || die "check: укажите ключ и значение"
    is_editable "$key" || die "ключ $key менять нельзя (см. stacksentry-menu keys)"
    check_value "$key" "$value"
    case "$key" in
        TELEGRAM_BOT_TOKEN | PANEL_API_TOKEN)
            ok "$key: значение корректно (скрыто, ${#value} символов)"
            ;;
        *)
            ok "$key=$value — значение корректно"
            ;;
    esac
}

is_secret_key() {
    case "$1" in
        *TOKEN* | *PASSWORD* | *SECRET*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_set() {
    local key value="" from_stdin=0 have_value=0
    if [ "${1:-}" = "--stdin" ]; then
        from_stdin=1
        key="${2:-}"
    else
        key="${1:-}"
        if [ "$#" -ge 2 ]; then
            value="${2:-}"
            have_value=1
        fi
    fi
    need_root "set"
    need_env
    [ -n "$key" ] || die "set: укажите ключ и значение"
    is_editable "$key" || die "ключ $key менять нельзя (см. stacksentry-menu keys)"
    if [ "$from_stdin" -eq 1 ]; then
        IFS= read -r value || value=""
        [ -n "$value" ] || die "set: значение не должно быть пустым"
    elif [ "$have_value" -eq 0 ]; then
        die "set: укажите ключ и значение"
    fi
    # Приводим адрес и путь к каноническому виду: без пробелов и лишних слешей,
    # иначе бот получит «https://host:5580//» и панель ответит 404.
    case "$key" in
        PANEL_URL | TELEGRAM_API_URL)
            value="$(printf '%s' "$value" | tr -d '[:space:]' | sed -E 's#/*$##')"
            ;;
        PANEL_BASE_PATH)
            value="$(printf '%s' "$value" | tr -d '[:space:]' | sed -E 's#^/*##; s#/*$##')"
            ;;
    esac
    check_value "$key" "$value"
    case "$value" in
        *$'\n'*) die "значение не должно содержать перевод строки" ;;
    esac

    id "$SERVICE_USER" >/dev/null 2>&1 \
        || die "нет системного пользователя $SERVICE_USER (переустановите бота)"

    local tmp="$ENV_FILE.tmp.$$"
    grep -vE "^${key}=" "$ENV_FILE" >"$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$key" "$value" >>"$tmp"
    install -o root -g "$(id -gn "$SERVICE_USER" 2>/dev/null || printf '%s' "$SERVICE_USER")" \
        -m 0640 "$tmp" "$ENV_FILE"
    rm -f "$tmp"
    ok "$key обновлён"
    info "Применится после перезапуска: sudo stacksentry-menu restart"
}

cmd_version() {
    local ver="?"
    if [ -r "$PREFIX/stacksentry/__init__.py" ]; then
        ver="$(sed -n 's/^__version__ = "\(.*\)"/\1/p' \
            "$PREFIX/stacksentry/__init__.py" 2>/dev/null | head -1)"
        [ -n "$ver" ] || ver="?"
    fi
    printf 'StackSentry %s\n' "$ver"
    printf 'PREFIX=%s\n' "$PREFIX"
    if [ -f "$ENV_FILE" ]; then
        printf 'PANEL_TYPE=%s\n' "$(sed -n 's/^PANEL_TYPE=//p' "$ENV_FILE" | head -1)"
    fi
}

cmd_detect() {
    need_env
    head1 "Что найдено на сервере"
    if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 не найден — автоопределение недоступно"
        return 0
    fi
    local out
    out="$(PYTHONPATH="$PREFIX" python3 -m stacksentry.inventory --platform 2>/dev/null || true)"
    [ -n "$out" ] && info "$out"
    out="$(PYTHONPATH="$PREFIX" python3 -m stacksentry.inventory 2>/dev/null || true)"
    if [ -n "$out" ]; then
        printf '%s\n' "$out" | sed 's/^/      /'
    else
        info "Панели и VPN-стек не найдены (или нет доступа к службам)."
    fi
    local ptype
    ptype="$(PYTHONPATH="$PREFIX" python3 -m stacksentry.inventory --panel-type 2>/dev/null || true)"
    if [ -n "$ptype" ]; then
        ok "Поддерживаемая API-панель: $ptype"
    else
        info "Поддерживаемых API-панелей не найдено — доступен monitor-only."
    fi
    info "Тип и доступы: пункты 8–12; повторный мастер: sudo bash $PREFIX/install.sh"
}

cmd_status() {
    head1 "Служба $SERVICE_NAME"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl status "$SERVICE_NAME" --no-pager 2>&1 | head -12 | sed 's/^/  /'
    else
        warn "systemctl не найден"
    fi
    if [ -f "$ENV_FILE" ]; then
        head1 "Последние ошибки в журнале"
        journalctl -u "$SERVICE_NAME" -p warning -n 10 --no-pager 2>&1 | sed 's/^/  /' \
            || true
    fi
}

cmd_logs() {
    local lines="${1:-50}"
    case "$lines" in (*[!0-9]*) die "logs: число строк" ;; esac
    journalctl -u "$SERVICE_NAME" -n "$lines" --no-pager
}

cmd_restart() {
    need_root "restart"
    command -v systemctl >/dev/null 2>&1 || die "systemctl не найден"
    systemctl restart "$SERVICE_NAME"
    sleep 2
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        ok "$SERVICE_NAME перезапущен и работает"
    else
        warn "служба не активна, смотрите: journalctl -u $SERVICE_NAME -n 30"
        exit 1
    fi
}

cmd_update_check() {
    need_env
    local py="$PREFIX/.venv/bin/python"
    [ -x "$py" ] || py="$(command -v python3 || true)"
    [ -n "$py" ] || die "не найден python3 (venv: $PREFIX/.venv)"
    PYTHONPATH="$PREFIX" "$py" -m stacksentry.updates
}

read_update_pin() {
    # Конфиг root-owned; значение задаёт оператор. Без pinned SHA256 обновление
    # запрещено: иначе root скачивал бы и исполнял mutable main.
    local conf="${PREFIX_CONF:-/etc/stacksentry.conf}"
    [ -r "$conf" ] || return 1
    (
        # shellcheck disable=SC1090
        . "$conf"
        printf '%s\n%s\n' "${UPDATE_SHA256:-}" "${UPDATE_REF:-main}"
    )
}

cmd_update() {
    need_root "update"
    # Не скачиваем установщик из main: подмена одного файла = root RCE.
    # Используем только локальную root-owned копию и pinned SHA256 архива.
    local installer="$PREFIX/install.sh"
    [ -f "$installer" ] || die "не найден $installer — переустановите бота"
    [ "$(stat -c '%u' "$installer" 2>/dev/null || echo '')" = "0" ] \
        || die "$installer должен принадлежать root"
    local mode
    mode="$(stat -c '%a' "$installer" 2>/dev/null || echo '')"
    case "$mode" in
        *[2367]) die "$installer доступен на запись группе/другим" ;;
    esac

    local sha ref
    { read -r sha; read -r ref; } < <(read_update_pin) || true
    [ -n "${ref:-}" ] || ref="main"

    local -a args=(--yes --update --prefix "$PREFIX" --ref "$ref")
    if [ -n "${sha:-}" ]; then
        info "Запускаю установщик (ref=$ref, sha=${sha:0:12}…)"
        args+=(--sha256 "$sha")
    else
        warn "Пин SHA256 не задан — обновляю ref=$ref без проверки хеша."
    fi
    PREFIX="$PREFIX" bash "$installer" "${args[@]}"
}

cmd_uninstall() {
    need_root "uninstall"
    local purge="${1:-}"
    local installer="$PREFIX/install.sh"
    [ -f "$installer" ] || installer="$PWD/install.sh"
    [ -f "$installer" ] || die "не найден install.sh"
    if [ "$purge" = "--keep-state" ]; then
        bash "$installer" --uninstall --keep-state --yes
    else
        bash "$installer" --uninstall --yes
    fi
}

ask() { printf '      %s' "$1"; }

ask_value() {
    # ask_value ПЕРЕМЕННАЯ "подсказка" "текущее" [secret]
    local var="$1" prompt="$2" current="$3" secret="${4:-0}" answer=""
    ask "$prompt"
    if [ "$secret" -eq 1 ]; then
        printf ' %s(ввод скрыт, Enter — оставить)%s ' "$DIM" "$RESET"
        read -rs answer <&$READ_FD || answer=""
        printf '\n'
    else
        [ -n "$current" ] && printf ' %s[%s]%s' "$DIM" "$current" "$RESET"
        printf ' '
        read -r answer <&$READ_FD || answer=""
    fi
    printf -v "$var" '%s' "${answer:-$current}"
}

menu_edit_key() {
    local key="$1"
    need_root "set"
    need_env
    local current hint
    current="$(sed -n "s/^${key}=//p" "$ENV_FILE" | head -1)"
    hint="${KEY_HINT[$key]:-новое значение}"
    info "$key — $hint"
    local value="" secret=0
    is_secret_key "$key" && secret=1
    ask_value value "Значение:" "$current" "$secret"
    if [ "$secret" -eq 1 ]; then
        printf '%s\n' "$value" | cmd_set --stdin "$key"
    else
        cmd_set "$key" "$value"
    fi
    local answer=""
    ask "Перезапустить бота сейчас? [Y/n] "
    read -r answer <&$READ_FD || answer=""
    case "$answer" in
        n|N|no|нет) info "Перезапуск отложен" ;;
        *) cmd_restart ;;
    esac
}

menu_pick() {
    # menu_pick "заголовок" KEY1 KEY2 … — подменю выбора ключа.
    local title="$1" ; shift
    local -a keys=("$@")
    head1 "$title"
    local i=1 k
    for k in "${keys[@]}"; do
        printf '  %d) %s\n' "$i" "$k"
        i=$(( i + 1 ))
    done
    ask "Номер (Enter — назад): "
    local pick=""
    read -r pick <&$READ_FD || pick=""
    case "$pick" in
        ""|0) return 0 ;;
        *[!0-9]*) warn "нужно число"; return 0 ;;
    esac
    if (( pick < 1 || pick > ${#keys[@]} )); then
        warn "нет такого пункта"
        return 0
    fi
    menu_edit_key "${keys[$(( pick - 1 ))]}"
}

cmd_totp() {
    need_root "totp"
    need_env
    local secret required
    secret="$(sed -n 's/^TOTP_SECRET=//p' "$ENV_FILE" | head -1)"
    required="$(sed -n 's/^TOTP_REQUIRED=//p' "$ENV_FILE" | head -1)"
    if [ -z "$secret" ]; then
        info "2FA отключена — TOTP не используется."
        info "Включить: sudo bash $PREFIX/install.sh --2fa"
        return 0
    fi
    printf 'TOTP_REQUIRED=%s\n' "${required:-0}"
    printf 'TOTP secret: %s\n' "$secret"
    local uri="otpauth://totp/StackSentry:admin?secret=${secret}&issuer=StackSentry"
    printf 'otpauth: %s\n' "$uri"
    show_totp_qr "$uri"
    info "Код 6 цифр меняется каждые 30 секунд."

    # Терминал — отдельный сервис и отдельный TOTP-секрет. Частая ошибка:
    # ввести в терминале код от входа в Mini App — он не подойдёт.
    local term_secrets="/etc/stacksentry/terminal-secrets.env"
    if [ -r "$term_secrets" ]; then
        local term_secret term_uri
        term_secret="$(sed -n 's/^TERMINAL_TOTP_SECRET=//p' "$term_secrets" | head -1)"
        if [ -n "$term_secret" ]; then
            printf '\nТерминал использует ОТДЕЛЬНЫЙ TOTP-секрет:\n'
            printf 'TERMINAL_TOTP_SECRET: %s\n' "$term_secret"
            term_uri="otpauth://totp/StackSentry:terminal?secret=${term_secret}&issuer=StackSentry"
            printf 'otpauth: %s\n' "$term_uri"
            show_totp_qr "$term_uri"
        fi
    fi
}

cmd_webapp() {
    need_root "webapp"
    need_env
    local enabled origin state domain
    enabled="$(sed -n 's/^WEBAPP_ENABLED=//p' "$ENV_FILE" | head -1)"
    origin="$(sed -n 's/^WEBAPP_PUBLIC_ORIGIN=//p' "$ENV_FILE" | head -1)"
    printf 'WEBAPP_ENABLED=%s\n' "${enabled:-0}"
    printf 'WEBAPP_PUBLIC_ORIGIN=%s\n' "${origin:-<пусто>}"
    if command -v systemctl >/dev/null 2>&1; then
        if systemctl is-active --quiet stacksentry-webapp 2>/dev/null; then
            state="работает"
        else
            state="не работает"
        fi
        printf 'служба stacksentry-webapp: %s\n' "$state"
        if command -v caddy >/dev/null 2>&1 \
            && systemctl is-active --quiet caddy 2>/dev/null; then
            printf 'HTTPS-прокси caddy: работает\n'
        fi
    fi
    if [ "${enabled:-0}" != "1" ] || [ -z "$origin" ]; then
        info "Кнопок Mini App не будет: нужны WEBAPP_ENABLED=1 и HTTPS-адрес."
        info "Включить автоматически: sudo bash $PREFIX/install.sh --webapp --no-terminal"
        info "Или со своим доменом: --webapp-origin https://..."
        return 0
    fi
    domain="${origin#https://}"
    domain="${domain%%:*}"
    info "После рестарта бота: sudo stacksentry-menu restart"
    info "Домен в Telegram: @BotFather -> /setdomain $domain"
}

cmd_apt_logs() {
    need_root "apt-logs"
    local lines="${1:-80}"
    case "$lines" in (*[!0-9]*) die "apt-logs: число строк" ;; esac
    if ! command -v journalctl >/dev/null 2>&1; then
        local log
        for log in "${STATE_DIR:-/var/lib/stacksentry}"/apt-*.log; do
            [ -f "$log" ] || continue
            printf '\n== %s ==\n' "$(basename "$log")"
            tail -n "$lines" "$log" 2>/dev/null || true
        done
        return 0
    fi
    local unit
    for unit in \
        stacksentry-apt-update \
        stacksentry-apt-upgrade \
        stacksentry-apt-phased \
        stacksentry-release-upgrade; do
        printf '\n== %s ==\n' "$unit"
        journalctl -u "$unit" -n "$lines" --no-pager 2>/dev/null \
            || printf '  (журнала нет)\n'
    done
}

cmd_restart_xray() {
    need_root "restart-xray"
    need_env
    local py="$PREFIX/.venv/bin/python"
    if [ ! -x "$py" ]; then
        py="$(command -v python3 || true)"
    fi
    [ -n "$py" ] || die "не найден python3 (venv: $PREFIX/.venv)"
    # Используем те же адаптеры, что и бот: токены не попадают в argv/ps,
    # а поддерживаемые панели определяются по PANEL_TYPE автоматически.
    if ! PYTHONPATH="$PREFIX" ENV_FILE="$ENV_FILE" "$py" - <<'PY'
import asyncio
import os
import sys
from pathlib import Path

try:
    from stacksentry.collectors.panels import build_panel
    from stacksentry.settings import load_settings
except Exception as exc:  # noqa: BLE001 — сообщаем причину в меню
    print(f"Не удалось загрузить StackSentry: {exc}", file=sys.stderr)
    raise SystemExit(1)


async def main() -> None:
    settings = load_settings(Path(os.environ["ENV_FILE"]))
    panel = build_panel(settings)
    try:
        result = await panel.restart_xray()
    finally:
        await panel.close()
    suffix = ""
    if isinstance(result, dict) and result.get("backend"):
        suffix = f" (backend {result['backend']})"
    print(f"Ядро панели перезапущено{suffix}")


try:
    asyncio.run(main())
except Exception as exc:  # noqa: BLE001 — ошибка панели и есть ответ меню
    print(f"Не удалось перезапустить ядро: {exc}", file=sys.stderr)
    raise SystemExit(1)
PY
    then
        warn "Рестарт не выполнен — смотрите сообщение выше"
        return 0
    fi
}

menu() {
    local max
    max="$(menu_max)"
    while true; do
        if [ -t 1 ] && [ -z "${STACKSENTRY_NO_CLEAR:-}" ] && command -v clear >/dev/null 2>&1; then
            clear
        fi
        draw_menu "$(menu_status_line)"
        ask "Выберите пункт [0-$max]: "
        local choice=""
        read -r choice <&$READ_FD || choice=""
        case "$choice" in
            q|Q|"") continue ;;
        esac
        case "$choice" in
            1) cmd_status ;;
            2) cmd_show ;;
            3) cmd_logs 50 ;;
            4) cmd_detect ;;
            5) menu_edit_key TELEGRAM_BOT_TOKEN ;;
            6) menu_edit_key TELEGRAM_ADMIN_IDS ;;
            7) menu_edit_key ALERT_CHAT_ID ;;
            8) menu_edit_key PANEL_TYPE ;;
            9) menu_edit_key PANEL_URL ;;
            10) menu_edit_key PANEL_BASE_PATH ;;
            11) menu_edit_key PANEL_API_TOKEN ;;
            12) menu_pick "Доступы Marzban" PANEL_USERNAME PANEL_PASSWORD ;;
            13) menu_pick "Сертификат панели" PANEL_VERIFY_TLS PANEL_CA_BUNDLE ;;
            14) menu_pick "Порог CPU" CPU_WARN CPU_CRIT ;;
            15) menu_pick "Порог памяти" MEM_WARN MEM_CRIT ;;
            16) menu_pick "Порог диска" DISK_WARN DISK_CRIT ;;
            17) menu_pick "Гистерезис и кулдаун" ALERT_HYSTERESIS ALERT_COOLDOWN ;;
            18) menu_edit_key EXPIRING_SOON_DAYS ;;
            19) menu_edit_key SERVICES ;;
            20) menu_edit_key LOG_LEVEL ;;
            21)
                ask "Имя ключа (stacksentry-menu keys — список): "
                local key=""
                read -r key <&$READ_FD || key=""
                [ -n "$key" ] && menu_edit_key "$key"
                ;;
            22) cmd_restart ;;
            23)
                ask "Перезапустить ядро панели? [y/N] "
                local yes=""
                read -r yes <&$READ_FD || yes=""
                case "$yes" in (y|Y|yes|да) cmd_restart_xray ;; (*) info "Отменено" ;; esac
                ;;
            24) cmd_update ;;
            25) cmd_update_check ;;
            26) cmd_totp ;;
            27) cmd_webapp ;;
            28)
                ask "Удалить бота? Это необратимо, введите yes: "
                local confirm=""
                read -r confirm <&$READ_FD || confirm=""
                case "$confirm" in
                    yes|YES|да)
                        cmd_uninstall
                        # Бот и само меню удалены — возвращаться некуда.
                        exit 0
                        ;;
                    *) info "Отменено" ;;
                esac
                ;;
            29) menu_edit_key LANGUAGE ;;
            0) exit 0 ;;
            *) warn "Нет такого пункта: $choice (0-$max)" ;;
        esac
        if [ -t 0 ] || [ "$READ_FD" = "3" ]; then
            ask "Enter — вернуться в меню…"
            read -r _ <&$READ_FD || true
        fi
    done
}

usage() {
    cat <<EOF
${BOLD}stacksentry-menu${RESET} — панель управления StackSentry

  sudo stacksentry-menu                     интерактивное меню
  sudo stacksentry-menu status              состояние службы и последние ошибки
  sudo stacksentry-menu show                текущие настройки (секреты замаскированы)
  sudo stacksentry-menu detect              что найдено: ОС, панели, VPN, службы
  stacksentry-menu version                  версия StackSentry и PREFIX
  stacksentry-menu keys                     какие ключи разрешено менять
  stacksentry-menu check KEY VALUE          проверить значение (без изменений)
  sudo stacksentry-menu set KEY VALUE       изменить настройку и подсказать рестарт
  sudo stacksentry-menu restart             перезапустить бота
  sudo stacksentry-menu restart-xray        перезапустить ядро панели (где поддерживается)
  sudo stacksentry-menu apt-logs [N]        журнал фоновых apt-обновлений
  sudo stacksentry-menu totp               TOTP-секрет и otpauth (только root)
  sudo stacksentry-menu webapp             статус Mini App и адрес для /setdomain
  sudo stacksentry-menu logs [N]            журнал бота (по умолчанию 50 строк)
  sudo stacksentry-menu update-check        проверить обновления StackSentry
  sudo stacksentry-menu update              обновить бота с GitHub
  sudo stacksentry-menu uninstall [--keep-state]  удалить бота целиком (без флагов — под ноль)

Пути: PREFIX=$PREFIX, .env=$ENV_FILE

${BOLD}English${RESET}
  sudo stacksentry-menu                     interactive menu
  sudo stacksentry-menu status              service state and recent errors
  sudo stacksentry-menu show                current settings (secrets masked)
  sudo stacksentry-menu detect              detected OS, panels, VPN, services
  stacksentry-menu version                  StackSentry version and PREFIX
  stacksentry-menu keys                     keys that may be changed
  stacksentry-menu check KEY VALUE          validate a value (no changes)
  sudo stacksentry-menu set KEY VALUE       change a setting, then restart
  sudo stacksentry-menu restart | logs [N]  restart the bot / show the log
  sudo stacksentry-menu restart-xray        restart the panel core when supported
  sudo stacksentry-menu apt-logs [N]        log of background apt upgrades
  sudo stacksentry-menu totp               TOTP secret and otpauth (root only)
  sudo stacksentry-menu webapp             Mini App status and /setdomain address
  sudo stacksentry-menu update-check        check for StackSentry updates
  sudo stacksentry-menu update              update the bot from GitHub
  sudo stacksentry-menu uninstall [--keep-state]  remove the bot (full cleanup by default)
  Docs: README.en.md (English) · README.md (Русский)
EOF
}

case "${1:-}" in
    ""|menu) menu ;;
    status) cmd_status ;;
    show|settings) cmd_show ;;
    detect|stack) cmd_detect ;;
    version) cmd_version ;;
    keys) cmd_keys ;;
    check) cmd_check "${2:-}" "${3:-}" ;;
    set) cmd_set "${2:-}" "${3:-}" ;;
    restart) cmd_restart ;;
    restart-xray) cmd_restart_xray ;;
    apt-logs) cmd_apt_logs "${2:-80}" ;;
    totp) cmd_totp ;;
    webapp|mini-app|miniapp) cmd_webapp ;;
    logs) cmd_logs "${2:-50}" ;;
    update) cmd_update ;;
    update-check|check-updates) cmd_update_check ;;
    uninstall|remove) cmd_uninstall "${2:-}" ;;
    help|--help|-h) usage ;;
    *) die "неизвестная команда: $1 (см. stacksentry-menu --help)" ;;
esac
